 case"S":s.di=z(3.2*g);s.tk=z(78*f);break;
 case"K":s.fg=z(30*g)}
 return s}
function avf(p,s,u){var x=0;switch(p.pos){case"QB":x=s.py/400+s.pt*.6-s.pi*.5+s.ry/200;break;case"RB":x=s.ry/150+s.rt*.6+s.rv/150;break;case"WR":case"TE":x=s.rv/100+s.rtd*.6;break;case"DL":x=s.sk*1.2+s.tk/25;break;case"LB":x=s.tk/18+s.sk+s.di*2;break;case"CB":x=s.di*2.5+s.tk/20;break;case"S":x=s.di*2.5+s.tk/22;break;case"K":x=s.fg/3;break;case"P":x=5*u;break;case"OL":x=u*(p.ovr-45)/4.5}return Math.max(0,x)}
function win(a,b,str){return Math.random()<1/(1+Math.exp((str[b]-str[a])/3))}
function play(){
 var N=32,by=[],str=[],i,g,k,pos,yr=S.season;
 for(i=0;i<N;i++){by.push({});S.tm[i]={w:0,l:0,c:0}}
 S.p.forEach(function(p){(by[p.t][p.pos]=by[p.t][p.pos]||[]).push(p)});
 for(i=0;i<N;i++){var tot=0;for(pos in by[i])by[i][pos].sort(function(a,b){return b.ovr-a.ovr});
  for(pos in SW)SW[pos].forEach(function(w,j){var x=by[i][pos]&&by[i][pos][j];tot+=w*(x?x.ovr:40)});str[i]=tot/SWS}
 for(g=0;g<17;g++){var o=[];for(i=0;i<N;i++)o.push(i);o.sort(function(){return Math.random()-.5});
  for(k=0;k<N;k+=2){var a=o[k],b=o[k+1],aw=win(a,b,str);S.tm[aw?a:b].w++;S.tm[aw?b:a].l++}}
 var sd=[],rk={};for(i=0;i<N;i++)sd.push(i);sd.sort(function(a,b){return S.tm[b].w-S.tm[a].w||str[b]-str[a]});
 sd.forEach(function(t,j){rk[t]=j;S.tm[t].po=j<16});
 var f=sd.slice(0,16);while(f.length>1){var nx=[],n=f.length;for(k=0;k<n/2;k++){var a=f[k],b=f[n-1-k];nx.push(win(a,b,str)?a:b)}f=nx.sort(function(a,b){return rk[a]-rk[b]})}
 var ch=f[0];S.tm[ch].c=1;
 var all=[];
 for(i=0;i<N;i++)for(pos in by[i])by[i][pos].forEach(function(p,d){var u=(U[p.pos]||[])[d]||0,s=gstat(p,u),a=avf(p,s,u);p.s=s;for(var key in s)p.c[key]=(p.c[key]||0)+s[key];p.av+=a;if(p.t===ch)p.rg++;p.L.push({y:yr,t:p.t,o:p.ovr,s:s,a:Math.round(a)});p.sc=p.ovr+(PV[p.pos]||0)+Math.min(8,a/3);all.push(p)});
 all.sort(function(a,b){return b.sc-a.sc});
 var np={};all.slice(0,100).forEach(function(p,j){np[p.id]=j+1;if(j<10)p.t10++;if(j===0)p.mvp++});
 S.top=all.slice(0,100).map(function(p){return{id:p.id,n:p.n,pos:p.pos,t:p.t,age:p.age,o:p.ovr,sc:Math.round(p.sc*10)/10,pv:S.prev[p.id]||0}});S.prev=np;
 ST.forEach(function(x){var kk=x[0],c=S.p.filter(function(p){return p.s[kk]>0}).sort(function(a,b){return b.s[kk]-a.s[kk]}).slice(0,10).map(function(p){return{n:p.n,pos:p.pos,t:p.t,y:yr,v:p.s[kk]}});S.rec[kk]=(S.rec[kk]||[]).concat(c).sort(function(a,b){return b.v-a.v}).slice(0,10)});
 var lines=[],hofs=[],nret=0,keep=[],best=all[0];
 S.p.forEach(function(p){var a=p.age,d;if(a<=25)d=rnd(0,1+Math.ceil((p.pot-p.ovr)/4));else if(a<=29)d=rnd(-1,1);else if(a<=33)d=-rnd(0,2);else d=-rnd(1,3);
  p.ovr=clamp(p.ovr+d,35,d>0?Math.max(p.pot,p.ovr):99);p.age=a+1;a=p.age;
  var c=a>=40?1:a===39?.75:a===38?.55:a===37?.35:0;
  if(Math.random()<c){nret++;p.ry=yr;p.lt=p.t;p.t=-1;var ind=hf(p)>=HOFT&&!p.inh;if(ind){p.inh=1;S.hof.push(p);hofs.push(esc(p.n))}S.ret.push(p);
   if((p.ovr>=72||ind)&&lines.length<25)lines.push(esc(p.n)+" ("+p.pos+", "+NK[p.lt]+") retired at "+a+(ind?' <span class="up">and was inducted into the Hall of Fame</span>':"")+".")}else keep.push(p)});
 S.p=keep;
 var cnt={},nr=0;S.p.forEach(function(p){var kk=p.t+p.pos;cnt[kk]=(cnt[kk]||0)+1});
 for(i=0;i<N;i++)POS.forEach(function(g){for(var j=cnt[i+g[0]]||0;j<g[1];j++){S.p.push(mk(g[0],j,i,1));nr++}});
 S.log.unshift({y:yr,ch:T(ch),rec:S.tm[ch].w+"-"+S.tm[ch].l,mvp:best.n+" ("+best.pos+", "+NK[best.t]+")",lines:lines,hofs:hofs,nret:nret,nr:nr});
 S.champ=NK[ch];S.played=yr;S.season++;save();render()}
function tbl(h,r){return'<div class="scroll"><table><tr>'+h.map(function(x){return'<th>'+x+'</th>'}).join('')+'</tr>'+r.map(function(x){return'<tr>'+x.map(function(c){return'<td>'+c+'</td>'}).join('')+'</tr>'}).join('')+'</table></div>'}
