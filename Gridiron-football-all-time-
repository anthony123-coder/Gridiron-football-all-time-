 (np||t>=0?fld('Team','<select id="ft">'+CI.map(function(c,i){return opt(i,T(i),i===t)}).join('')+'</select>'):'')+
 fld('Age','<input id="fa" type="number" min="18" max="45" value="'+age+'">')+
 fld('Overall','<input id="fo" type="number" min="35" max="99" value="'+o+'">')+
 fld('Potential','<input id="fq" type="number" min="35" max="99" value="'+pt+'">')+
 '</div><p style="margin-top:12px"><button class="btn go" data-a="savep">'+(np?'Create and sign player':'Save changes')+'</button>'+(np?'':'<button class="btn alt" data-a="cancel">Cancel</button>')+'</p>'+(np?'<p class="mu">The new player joins the team you pick. Rosters can grow past 53 and shrink back as players retire.</p>':'')}
