section{background:var(--p);border:1px solid var(--ln);border-radius:10px;padding:14px}
.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:480px}
th,td{padding:7px 6px;text-align:left;border-bottom:1px solid var(--ln);white-space:nowrap}th{font-size:12px;color:var(--mu)}
.btn{background:var(--hd);color:#fff;border:0;border-radius:8px;padding:7px 12px;font:inherit;font-weight:600;cursor:pointer;margin:0 4px 6px 0}
.btn.alt{background:transparent;color:var(--ink);border:1px solid var(--ln)}.btn.go{background:var(--ac);color:#1a1300;padding:10px 16px}
.lnk{background:none;border:0;padding:0;font:inherit;color:var(--lk);text-decoration:underline;cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
input,select{font:inherit;padding:9px;border:1px solid var(--ln);border-radius:8px;background:var(--bg);color:var(--ink)}
.mu{color:var(--mu);margin:0 0 10px}.up{color:var(--up);font-weight:600}.dn{color:var(--dn);font-weight:600}
.empty{color:var(--mu);padding:20px 0;text-align:center}h3{margin:14px 0 6px;font:700 18px Oswald,sans-serif}
ul{list-style:none;margin:0;padding:0}li{padding:5px 0;border-bottom:1px solid var(--ln)}
.badge{display:inline-block;font-size:10px;background:var(--ac);color:#1a1300;padding:1px 6px;border-radius:10px;margin-left:6px;font-weight:700;vertical-align:middle}
</style>
